# EventEase Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas URI (or local MongoDB for development)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/eventease?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super-secret-eventease-jwt-token-replace-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# CORS Client URL
CLIENT_URL=http://localhost:5173

# Initial Platform Administrator Seed Credentials (Used by npm run seed:admin)
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@eventease.com
ADMIN_PASSWORD=AdminSecurePass123!
